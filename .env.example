# LifeSync AI Pro environment example
#
# This project uses normal operating-system environment variables.
# This file is documentation only unless you later add a .env loader.

# Development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata

# Production example
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=replace-with-a-unique-production-secret
# DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_TRUST_PROXY_SSL_HEADER=True
# DJANGO_HSTS_SECONDS=31536000

DJANGO_LOG_LEVEL=INFO

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=LifeSync AI <noreply@localhost>
